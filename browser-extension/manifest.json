{
  "manifest_version": 3,
  "name": "Memory Compression",
  "version": "1.0.0",
  "description": "关闭最后一个本地预览页后停止对应开发服务；内存释放引擎可选。",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://[::1]/*",
    "https://localhost/*",
    "https://127.0.0.1/*",
    "https://[::1]/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Memory Compression",
    "default_popup": "popup.html"
  }
}
